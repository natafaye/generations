<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="cost-item" data-source-type="ItemAmount, Assembly-CSharp" style="flex-direction: row; align-items: center; margin-right: 5px;">
        <ui:Image style="width: 24px; height: 24px; margin-right: 2px;">
            <Bindings>
                <ui:DataBinding property="source" data-source-path="Type.Sprite" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Image>
        <ui:Label text="10" style="-unity-font-style: bold;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="Amount" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
    </ui:VisualElement>
</ui:UXML>
